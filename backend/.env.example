# Copy to backend/.env and edit for the machine that runs the backend.

# --- Lesson planner ---
LLM_BACKEND=ollama                 # ollama | mock (built-in sample lesson, no model)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=0                # unload LLM after planning to free VRAM for TTS

# --- Retrieval (RAG) over the offline knowledge base ---
RAG_ENABLED=1
EMBED_MODEL=nomic-embed-text
RAG_TOP_K=6
RAG_MIN_SCORE=0.68

# --- Translation ---
TRANSLATE_BACKEND=indictrans2      # indictrans2 | ollama | none
# Hugging Face id, or a local folder if the model is already on disk:
INDICTRANS2_MODEL=ai4bharat/indictrans2-en-indic-dist-200M

# --- Narration ---
TTS_ENGINE=piper                   # piper | parler | silent
TTS_FALLBACK=parler                # used where Piper has no voice (kn, ta, bn, gu)
PARLER_MODEL=ai4bharat/indic-parler-tts
# Folder holding the Piper *.onnx + *.onnx.json voice files:
# PIPER_DIR=C:\path\to\piper-voices
# MODELS_DIR=C:\path\to\models      # default: visual-teacher\models

# --- Runtime ---
DEVICE=auto                        # auto | cuda | cpu
PRELOAD=1                          # load models at startup so the first lesson is fast
CORS_ORIGINS=*                     # or e.g. http://192.168.1.20:5173
# Address the MP4 renderer uses to fetch audio + fonts from this server:
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Demo day: never touch the network ---
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
