# Disable Revideo telemetry (PostHog) so the pipeline makes zero network calls
DISABLE_TELEMETRY=true
# Ollama (local planner)
OLLAMA_HOST=http://127.0.0.1:11434
PLANNER_MODEL=qwen2.5:7b-instruct-q4_K_M
PLANNER_FALLBACK_MODEL=qwen2.5:3b-instruct-q4_K_M
# Paths
MODELS_DIR=./models
OUTPUT_DIR=./output
